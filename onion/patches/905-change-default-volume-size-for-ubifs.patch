From b29ff89228a2f407868328c0a791cf9a12a74a4b Mon Sep 17 00:00:00 2001
From: Yevhenii Onishchenko <yevhenii.onishchenko@lembergsolutions.com>
Date: Thu, 25 Jul 2024 18:46:30 +0300
Subject: [PATCH] Change default volume size for ubifs

---
 scripts/ubinize-image.sh | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/scripts/ubinize-image.sh b/scripts/ubinize-image.sh
index 323eae547a..f55f79a7b7 100755
--- a/scripts/ubinize-image.sh
+++ b/scripts/ubinize-image.sh
@@ -26,7 +26,7 @@ ubivol() {
 		echo "image=$image"
 		[ -n "$size" ] && echo "vol_size=${size}"
 	else
-		echo "vol_size=1MiB"
+		echo "vol_size=3MiB"
 	fi
 	if [ "$autoresize" ]; then
 		echo "vol_flags=autoresize"
-- 
2.25.1

