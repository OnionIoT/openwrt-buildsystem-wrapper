@@ -0,0 +1,20 @@
+--- a/deps/v8/src/base/cpu.cc
++++ b/deps/v8/src/base/cpu.cc
+@@ -199,6 +199,7 @@ static uint32_t ReadELFHWCaps() {
+ int __detect_fp64_mode(void) {
+   double result = 0;
+   // Bit representation of (double)1 is 0x3FF0000000000000.
++  /*
+   __asm__ volatile(
+       ".set push\n\t"
+       ".set noreorder\n\t"
+@@ -213,6 +214,9 @@ int __detect_fp64_mode(void) {
+       : "t0", "$f0", "$f1", "memory");
+ 
+   return !(result == 1);
++  */
++
++  return result;
+ }
+ 
