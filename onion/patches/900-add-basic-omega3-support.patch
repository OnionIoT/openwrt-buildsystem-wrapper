From 03ed049c3e98a736d2ea6703a5c3093c303e0229 Mon Sep 17 00:00:00 2001
From: Yevhenii Onishchenko <yevhenii.onishchenko@lembergsolutions.com>
Date: Thu, 11 Jul 2024 12:40:33 +0300
Subject: [PATCH] Add basic Omega3 support

---
 .../ramips/dts/mt7628an_onion_omega3.dts      | 195 ++++++++++++++++++
 target/linux/ramips/image/mt76x8.mk           |   9 +
 target/linux/ramips/mt76x8/config-5.15        |   3 +
 3 files changed, 207 insertions(+)
 create mode 100644 target/linux/ramips/dts/mt7628an_onion_omega3.dts

diff --git a/target/linux/ramips/dts/mt7628an_onion_omega3.dts b/target/linux/ramips/dts/mt7628an_onion_omega3.dts
new file mode 100644
index 0000000000..7c4976119c
--- /dev/null
+++ b/target/linux/ramips/dts/mt7628an_onion_omega3.dts
@@ -0,0 +1,195 @@
+#include "mt7628an.dtsi"
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+
+/ {
+	compatible = "onion,omega3", "mediatek,mt7628an-soc";
+
+	aliases {
+		led-boot = &led_system;
+		led-failsafe = &led_system;
+		led-running = &led_system;
+		led-upgrade = &led_system;
+	};
+
+	chosen {
+		bootargs = "console=ttyS0,115200";
+	};
+
+	leds {
+		compatible = "gpio-leds";
+
+		led_system: system {
+			label = "amber:system";
+			gpios = <&gpio 44 GPIO_ACTIVE_LOW>;
+		};
+	};
+
+	keys {
+		compatible = "gpio-keys";
+
+		reset {
+			label = "reset";
+			gpios = <&gpio 38 GPIO_ACTIVE_HIGH>;
+			linux,code = <KEY_RESTART>;
+		};
+	};
+};
+
+&gpio {
+  /* prevent auto-numbering GPIOs, retain traditional 0-based GPIOs */
+  /* (needs patch in gpio-mt7621.c to re-introduce the gpio-base property) */
+  gpio-base = <0>;
+};
+
+&state_default {
+	gpio {
+		groups = "gpio";
+		function = "gpio";
+	};
+
+	perst {
+		groups = "perst";
+		function = "gpio";
+	};
+
+	refclk {
+		groups = "refclk";
+		function = "gpio";
+	};
+
+	i2s {
+		groups = "i2s";
+		function = "gpio";
+	};
+
+	spis {
+		groups = "spis";
+		function = "gpio";
+	};
+
+	wled_kn {
+		groups = "wled_kn";
+		function = "gpio";
+	};
+
+	wled_an {
+		groups = "wled_an";
+		function = "gpio";
+	};
+
+	wdt {
+		groups = "wdt";
+		function = "gpio";
+	};
+
+	pwm0 {
+		groups = "pwm0";
+		function = "gpio";
+	};
+
+	pwm1 {
+		groups = "pwm1";
+		function = "gpio";
+	};
+};
+
+&spi0 {
+	status = "okay";
+
+	pinctrl-names = "default";
+	pinctrl-0 = <&spi_pins>, <&spi_cs1_pins>;
+
+	flash0: flash@0 {
+		compatible = "jedec,spi-nor";
+		reg = <0>;
+		spi-max-frequency = <40000000>;
+
+		partitions {
+			compatible = "fixed-partitions";
+			#address-cells = <1>;
+			#size-cells = <1>;
+
+			partition@0 {
+				label = "u-boot";
+				reg = <0x0 0xA0000>;
+				read-only;
+			};
+			partition@A0000 {
+				label = "u-boot-env";
+				reg = <0xA0000 0x10000>;
+				read-only;
+			};
+			factory: partition@B0000 {
+				label = "factory";
+				reg = <0xB0000 0x10000>;
+				read-only;
+			};
+		};
+	};
+
+	spi-nand@1 {
+		compatible = "spi-nand";
+		reg = <1>;
+		spi-max-frequency = <40000000>;
+
+		partitions {
+			compatible = "fixed-partitions";
+			#address-cells = <1>;
+			#size-cells = <1>;
+
+			partition@0 {
+				compatible = "denx,uimage";
+				label = "firmware";
+				reg = <0x0 0x10000000>;
+			};
+		};
+	};
+};
+
+&i2c {
+	status = "okay";
+};
+
+&uart1 {
+	status = "okay";
+};
+
+&uart2 {
+	status = "okay";
+};
+
+&ethernet {
+	nvmem-cells = <&macaddr_factory_28>;
+	nvmem-cell-names = "mac-address";
+};
+
+&sdhci {
+	status = "okay";
+	mediatek,cd-low;
+};
+
+&wmac {
+	status = "okay";
+
+	mediatek,mtd-eeprom = <&factory 0x0>;
+};
+
+&factory {
+	compatible = "nvmem-cells";
+	#address-cells = <1>;
+	#size-cells = <1>;
+
+	macaddr_factory_28: macaddr@28 {
+		reg = <0x28 0x6>;
+	};
+};
+
+&pwm {
+	status = "okay";
+};
+
+&flash0 {
+	broken-flash-reset;
+};
\ No newline at end of file
diff --git a/target/linux/ramips/image/mt76x8.mk b/target/linux/ramips/image/mt76x8.mk
index 816009ac18..b20e9efa7f 100644
--- a/target/linux/ramips/image/mt76x8.mk
+++ b/target/linux/ramips/image/mt76x8.mk
@@ -473,6 +473,15 @@ define Device/onion_omega2p
 endef
 TARGET_DEVICES += onion_omega2p
 
+define Device/onion_omega3
+  IMAGE_SIZE := 256m
+  DEVICE_VENDOR := Onion
+  DEVICE_MODEL := Omega3
+  DEVICE_PACKAGES:= kmod-usb2 kmod-usb-ohci uboot-envtools kmod-sdhci-mt7620
+  SUPPORTED_DEVICES += omega3
+endef
+TARGET_DEVICES += onion_omega3
+
 define Device/oraybox_x1
   IMAGE_SIZE := 15360k
   DEVICE_VENDOR := OrayBox
diff --git a/target/linux/ramips/mt76x8/config-5.15 b/target/linux/ramips/mt76x8/config-5.15
index 7248aa6633..75e8d6e088 100644
--- a/target/linux/ramips/mt76x8/config-5.15
+++ b/target/linux/ramips/mt76x8/config-5.15
@@ -112,9 +112,12 @@ CONFIG_MODULES_USE_ELF_REL=y
 CONFIG_MT7621_WDT=y
 # CONFIG_MTD_CFI_INTELEXT is not set
 CONFIG_MTD_CMDLINE_PARTS=y
+CONFIG_MTD_NAND_CORE=y
+CONFIG_MTD_NAND_ECC=y
 # CONFIG_MTD_PARSER_TPLINK_SAFELOADER is not set
 CONFIG_MTD_PARSER_TRX=y
 CONFIG_MTD_PHYSMAP=y
+CONFIG_MTD_SPI_NAND=y
 CONFIG_MTD_SPI_NOR=y
 CONFIG_MTD_SPI_NOR_USE_VARIABLE_ERASE=y
 CONFIG_MTD_SPLIT_TPLINK_FW=y
-- 
2.25.1

