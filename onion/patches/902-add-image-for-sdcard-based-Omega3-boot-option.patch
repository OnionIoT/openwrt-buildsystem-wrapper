From 537849bf37caf20f85d7bdaeeffef5b50ec40b1f Mon Sep 17 00:00:00 2001
From: Yevhenii Onishchenko <yevhenii.onishchenko@lembergsolutions.com>
Date: Thu, 25 Jul 2024 13:17:37 +0300
Subject: [PATCH] Add image for sdcard-based Omega3 boot option

---
 target/linux/ramips/Makefile                  |  4 ++-
 .../ramips/image/gen_omega3_sdcard_img.sh     | 28 +++++++++++++++++++
 target/linux/ramips/image/mt76x8.mk           | 17 +++++++++++
 target/linux/ramips/mt76x8/config-5.15        | 11 ++++++++
 4 files changed, 59 insertions(+), 1 deletion(-)
 create mode 100755 target/linux/ramips/image/gen_omega3_sdcard_img.sh

diff --git a/target/linux/ramips/Makefile b/target/linux/ramips/Makefile
index 2ac2270cb9..411b5dd5ba 100644
--- a/target/linux/ramips/Makefile
+++ b/target/linux/ramips/Makefile
@@ -8,7 +8,9 @@ ARCH:=mipsel
 BOARD:=ramips
 BOARDNAME:=MediaTek Ralink MIPS
 SUBTARGETS:=mt7620 mt7621 mt76x8 rt288x rt305x rt3883
-FEATURES:= dt-overlay squashfs gpio $(if $(CONFIG_TARGET_DEVICE_ramips_mt76x8_DEVICE_onion_omega3),nand ubifs,)
+FEATURES:= dt-overlay squashfs gpio\
+	if($(CONFIG_TARGET_DEVICE_ramips_mt76x8_DEVICE_onion_omega3), nand ubifs,) \
+	if($(CONFIG_TARGET_DEVICE_ramips_mt76x8_DEVICE_onion_omega3_sdcard), boot-part,)
 
 KERNEL_PATCHVER:=5.15
 
diff --git a/target/linux/ramips/image/gen_omega3_sdcard_img.sh b/target/linux/ramips/image/gen_omega3_sdcard_img.sh
new file mode 100755
index 0000000000..488a3517c7
--- /dev/null
+++ b/target/linux/ramips/image/gen_omega3_sdcard_img.sh
@@ -0,0 +1,28 @@
+#!/bin/sh
+
+set -e -x
+
+if [ $# -ne 5 ]; then
+    echo "SYNTAX: $0 <file> <bootfs image> <rootfs image> <bootfs size> <rootfs size>"
+    exit 1
+fi
+
+OUTPUT="$1"
+BOOTFS="$2"
+ROOTFS="$3"
+BOOTFSSIZE="$4"
+ROOTFSSIZE="$5"
+
+align=4096
+head=4
+kernel_type=c
+rootfs_type=83
+sect=63
+
+set $(ptgen -o $OUTPUT -h $head -s $sect -l $align -t $kernel_type -p ${BOOTFSSIZE}M -t $rootfs_type -p ${ROOTFSSIZE}M)
+
+BOOTOFFSET="$(($1 / 512))"
+ROOTFSOFFSET="$(($3 / 512))"
+
+dd bs=512 if="$BOOTFS" of="$OUTPUT" seek="$BOOTOFFSET" conv=notrunc
+dd bs=512 if="$ROOTFS" of="$OUTPUT" seek="$ROOTFSOFFSET" conv=notrunc
diff --git a/target/linux/ramips/image/mt76x8.mk b/target/linux/ramips/image/mt76x8.mk
index 12f5d2e2fc..639d4e6ac2 100644
--- a/target/linux/ramips/image/mt76x8.mk
+++ b/target/linux/ramips/image/mt76x8.mk
@@ -487,6 +487,23 @@ define Device/onion_omega3
 endef
 TARGET_DEVICES += onion_omega3
 
+define Build/sdcard-img
+  ./gen_omega3_sdcard_img.sh $@ $(IMAGE_KERNEL) $(IMAGE_ROOTFS) \
+    $(CONFIG_TARGET_KERNEL_PARTSIZE) $(CONFIG_TARGET_ROOTFS_PARTSIZE)
+endef
+
+define Device/onion_omega3_sdcard
+  IMAGE_SIZE := 32448k
+  DEVICE_DTS := mt7628an_onion_omega3
+  DEVICE_VENDOR := Onion
+  DEVICE_MODEL := Omega3
+  DEVICE_VARIANT := SDCARD
+  DEVICE_PACKAGES:= kmod-usb2 kmod-usb-ohci uboot-envtools kmod-sdhci-mt7620
+  SUPPORTED_DEVICES += omega3
+  IMAGE/sysupgrade.bin := sdcard-img | append-metadata
+endef
+TARGET_DEVICES += onion_omega3_sdcard
+
 define Device/oraybox_x1
   IMAGE_SIZE := 15360k
   DEVICE_VENDOR := OrayBox
diff --git a/target/linux/ramips/mt76x8/config-5.15 b/target/linux/ramips/mt76x8/config-5.15
index daa0ef2470..67db198c10 100644
--- a/target/linux/ramips/mt76x8/config-5.15
+++ b/target/linux/ramips/mt76x8/config-5.15
@@ -30,6 +30,8 @@ CONFIG_CPU_SUPPORTS_32BIT_KERNEL=y
 CONFIG_CPU_SUPPORTS_HIGHMEM=y
 CONFIG_CPU_SUPPORTS_MSA=y
 CONFIG_CRC16=y
+CONFIG_CRC7=y
+CONFIG_CRC_ITU_T=y
 CONFIG_CRYPTO_DEFLATE=y
 CONFIG_CRYPTO_HASH_INFO=y
 CONFIG_CRYPTO_LIB_BLAKE2S_GENERIC=y
@@ -110,6 +112,12 @@ CONFIG_MIPS_LD_CAN_LINK_VDSO=y
 # CONFIG_MIPS_NO_APPENDED_DTB is not set
 CONFIG_MIPS_RAW_APPENDED_DTB=y
 CONFIG_MIPS_SPRAM=y
+CONFIG_MMC=y
+CONFIG_MMC_BLOCK=y
+CONFIG_MMC_SDHCI=y
+# CONFIG_MMC_SDHCI_PCI is not set
+CONFIG_MMC_SDHCI_PLTFM=y
+CONFIG_MMC_SPI=y
 CONFIG_MODULES_USE_ELF_REL=y
 CONFIG_MT7621_WDT=y
 # CONFIG_MTD_CFI_INTELEXT is not set
@@ -129,6 +137,9 @@ CONFIG_MTD_UBI_BEB_LIMIT=20
 CONFIG_MTD_UBI_BLOCK=y
 CONFIG_MTD_UBI_WL_THRESHOLD=4096
 CONFIG_MTD_VIRT_CONCAT=y
+# CONFIG_MTK_AEE_KDUMP is not set
+CONFIG_MTK_MMC=y
+# CONFIG_MTK_MMC_CD_POLL is not set
 CONFIG_NEED_DMA_MAP_STATE=y
 CONFIG_NEED_PER_CPU_KM=y
 CONFIG_NET_RALINK_ESW_RT3050=y
